# Current authenticated local Codex CLI supplies the language model.
LLM_PROVIDER=codex
# Optional later: LLM_PROVIDER=openai_compatible and all three below.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# Official Wallex MCP uses X-API-Key (private_reads opt-in in JSON).
# Public market tools require no key. Other remote MCPs may use a bearer token.
# WALLEX_MCP_BEARER_TOKEN=
# WALLEX_API_KEY=
LANGSMITH_TRACING=false
